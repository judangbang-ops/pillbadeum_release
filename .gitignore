# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# The Gradle wrapper jar must be committed
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle / Android build outputs
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/

# Machine-local settings (Android SDK path) - never commit
local.properties

# IDE / OS
.idea/
*.iml
.DS_Store

# Python bytecode (scripts/emulator, .github/scripts)
__pycache__/
*.pyc

# 실기기 확인의 원본(화면 덤프·알림 목록·로그, scripts/device/device-check.ps1). 보고서에는 고른 캡처와 숫자만 옮김
docs/07-qa/*/raw/
