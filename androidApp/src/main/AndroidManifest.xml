<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Re-arm the day-boundary widget refresh after a reboot. No exact-alarm permission is used. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Backup (TASK-028, REQ-055): only the record database and its -wal/-journal files, cloud backup
        only with a screen lock (decision Q16). Rules: res/xml/data_extraction_rules.xml (Android 12+)
        and res/xml/backup_rules.xml (Android 11 and earlier; Android 8.x does not back up).
        Restore is detected on first start by install_marker in noBackupFilesDir (TASK-029).
    -->
    <application
        android:name=".DidITakeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DidITakeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/diditake_widget_info" />
        </receiver>

        <!-- Day-boundary alarm (own explicit intent) plus system time/boot broadcasts. -->
        <receiver
            android:name=".boundary.DayBoundaryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
