<?xml version="1.0" encoding="utf-8"?>
<!--
    Overflow arrow (REQ-078, TASK-044 drawing .more): a white tab with 9dp top corners, the same tab in
    color.line.subtle 1dp higher behind it as the edge, and the down chevron. Drawn at 44x19dp with
    ContentScale.FillBounds.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E3E5E9" />
            <corners android:topLeftRadius="9dp" android:topRightRadius="9dp" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:topLeftRadius="9dp" android:topRightRadius="9dp" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:width="12dp"
        android:height="12dp"
        android:drawable="@drawable/ic_widget_down"
        android:gravity="center" />
</layer-list>
