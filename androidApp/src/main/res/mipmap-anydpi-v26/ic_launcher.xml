<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon (TASK-045): a capsule with a check badge. The launcher masks it to its own shape (circle, rounded
     square); Android 13 and later tint the monochrome layer for themed icons. minSdk is 26, so no bitmaps are needed.
     The store icon docs/release/listing/ko-KR/images/icon.png is drawn from the same shapes. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
